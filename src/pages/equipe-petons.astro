.continuity-visual{background:#f7f2e7}
.soft-mark{position:relative;display:inline-block;isolation:isolate}
.soft-mark:after{content:'';position:absolute;bottom:9px;left:-2px;right:0;height:16px;background:#e6edb4;z-index:-1;border-radius:60% 30% 50% 30%;transform:rotate(-1deg)}
.continuity .marker-orange{font-weight:800;padding:0 2px;background:linear-gradient(transparent 42%,#ffd0a1 42%)}
.association-heading{display:flex;align-items:center;justify-content:space-between;gap:42px;padding:0;margin-bottom:25px}
