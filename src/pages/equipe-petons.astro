*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:25px}body{margin:0;background:var(--paper);color:var(--body);font:16px/1.75 Nunito,Arial,sans-serif}h1,h2,h3,h4{margin:0;color:var(--heading)}h1,h2,h3{font-family:var(--title);font-weight:700;line-height:1.25}h1{font-size:53px;letter-spacing:-1px}h2{font-size:39px;letter-spacing:-.65px}h3{font-size:29px}p{margin:0 0 18px}p:last-child{margin-bottom:0}a{color:var(--heading);text-underline-offset:4px}a:focus-visible,button:focus-visible{outline:3px solid var(--ink);outline-offset:5px}button{font:inherit}img{display:block;max-width:100%}figure{margin:0}.wrap{width:min(1216px,100%);padding:0 40px;margin:auto}.section{padding-top:64px;padding-bottom:64px}.icon{width:26px;height:26px;flex-shrink:0}.eyebrow{font-size:10px;letter-spacing:1.4px;font-weight:800;text-transform:uppercase;color:var(--heading);margin-bottom:17px}.button{display:inline-flex;justify-content:center;align-items:center;gap:13px;min-height:49px;padding:13px 24px;border:1.5px solid var(--orange);border-radius:30px;text-decoration:none;font-size:14px;font-weight:800;line-height:1.4;background:var(--orange);color:#294c5b}.button:hover{background:#ffa35b}.button .icon{width:17px;height:17px}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:white;padding:15px;z-index:10}.marker{background:linear-gradient(transparent 57%,#e4edb2 57%);box-decoration-break:clone;-webkit-box-decoration-break:clone;padding:0 2px}.marker-orange{background:linear-gradient(transparent 57%,#ffdfb4 57%)}.painted{mix-blend-mode:multiply;object-fit:contain}.star{color:#e5ab34;font:35px/1 Georgia,serif;display:inline-block}.section-title{display:flex;align-items:center;gap:14px;margin-bottom:35px}.section-title>.icon{color:#70b45b;width:30px;height:30px}.section-title h2{position:relative;isolation:isolate}.section-title h2:after{content:'';position:absolute;left:0;bottom:0;width:62%;height:5px;background:#f7bc78;border-radius:65% 25% 50% 30%;transform:rotate(-1.4deg);z-index:-1}.section-title>.star{font-size:27px;margin-left:5px}
header{background:#fcfcfa;border-bottom:1px solid #eee9df}.header-inner{height:114px;display:flex;justify-content:space-between;align-items:center;gap:22px}.brand{display:block;flex:none}.brand img{width:294px;height:auto}.mainnav{display:flex;gap:21px;font-size:12px;font-weight:800;align-items:center}.mainnav span,.mainnav a{white-space:nowrap;text-decoration:none}.mainnav [aria-current]{position:relative}.mainnav [aria-current]:after{content:'';position:absolute;height:3px;background:var(--orange);bottom:-6px;left:0;right:0;border-radius:60%}.header-inner>.button{font-size:12px;min-height:44px;padding:12px 19px}.mobile-toggle{display:none}#mobile-menu[hidden]{display:none}
