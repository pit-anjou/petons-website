footer{background:#fcfcfa;border-top:1px solid #e6e8dd;padding:35px 0 25px}.footer-grid{display:grid;grid-template-columns:1.1fr 1.2fr .75fr .9fr;gap:31px;font-size:13px}.footer-grid .brand img{width:250px}.footer-grid h3{font:800 14px Nunito,sans-serif;margin-bottom:17px}.footer-grid p{line-height:2}.footer-grid address{font-style:normal;font-size:13px}.footer-grid address>span,.footer-grid address>a{position:relative;padding-left:24px;display:block;margin-bottom:10px;text-decoration:none}.footer-grid address .icon{position:absolute;left:0;top:3px;width:15px;height:15px;color:#5d9d85}.copyright{display:flex;justify-content:space-between;gap:16px;border-top:1px solid #e5e8dd;margin-top:28px;padding-top:20px;font-size:11px;color:#65808a}
