.association{border-top:1px solid var(--line);padding-top:58px;padding-bottom:54px}.association-intro{display:grid;grid-template-columns:350px 1fr;gap:58px;align-items:start;margin-bottom:45px}.association-heading{position:relative;padding-right:13px}.association-heading h2{font-size:36px;margin-bottom:23px}.association-heading>img{width:69px;height:91px;object-fit:contain;margin-top:23px}.association-copy p{font-size:15.5px}.association-copy p:last-child{border-left:3px solid #b8d297;padding-left:20px;font-weight:700}.bureau-grid{display:grid;grid-template-columns:1.12fr 1fr 1fr;gap:33px}.bureau-person{padding-top:23px;border-top:3px solid #d7e5bb}.bureau-person:nth-child(2){border-color:#f3d2ad}.bureau-person:nth-child(3){border-color:#b7dfdb}.bureau-top{display:flex;align-items:center;gap:13px;margin-bottom:11px}.bureau-top>.icon{color:#71a952;width:26px;height:26px}.bureau-person:nth-child(2) .bureau-top>.icon{color:#c1813e}.bureau-person:nth-child(3) .bureau-top>.icon{color:#468e91}.bureau-top h3{font-size:32px}.bureau-role{font-size:13px;font-weight:800;line-height:1.5;min-height:40px;margin-bottom:19px}.bureau-person>p:not(.bureau-role){font-size:14.5px;line-height:1.82}
.roles{display:grid;grid-template-columns:1fr 1.15fr;gap:43px;align-items:center;background:#eef3e3;padding:29px 33px;margin-top:38px;border-radius:0 40px 0 0;border-bottom:2px solid #d4e0b6}.roles h2{font-size:31px;margin-bottom:14px}.roles p{font-size:14.5px}.roles-labels{display:grid;grid-template-columns:1fr 1fr;gap:20px}.role-label{display:flex;flex-direction:column;gap:8px;font-size:13px;font-weight:700;line-height:1.6}.role-label>.icon{width:28px;height:28px;color:#639e68}.role-label strong{font-size:15px;color:var(--heading)}
