/* Navigation et pied de page communs aux Petons. */
.cm-site-header{background:#fcfcfa;border-bottom:1px solid #eee9df;position:relative;z-index:50;}
.cm-header-inner{width:min(1216px,100%);margin:auto;padding:0 40px;min-height:114px;display:flex;justify-content:space-between;align-items:center;gap:20px;}
.cm-brand{display:block;flex:0 0 294px;}.cm-brand img{width:294px;height:auto;max-width:100%;}
.cm-nav{margin-left:0;font:800 12px/1.4 Nunito,Arial,sans-serif;color:#316573;}
.cm-nav-list{list-style:none;display:flex;align-items:center;gap:15px;margin:0;padding:0;}
.cm-nav-list>li{margin:0;padding:0;}
.cm-site-header .cm-nav a{color:#316573;text-decoration:none;white-space:nowrap;display:inline-block;padding:10px 0;position:relative;}
.cm-site-header .cm-nav a:hover:after,.cm-site-header .cm-nav a[aria-current="page"]:after,.cm-site-header .cm-nav a.is-current-parent:after{content:'';position:absolute;height:3px;background:#f89141;bottom:3px;left:0;right:0;border-radius:60%;}
.cm-nav-group{position:relative;}.cm-nav-parent{display:flex;align-items:center;gap:4px;}
.cm-submenu-toggle{border:0;background:none;color:#316573;display:flex;align-items:center;justify-content:center;padding:10px 3px;min-width:26px;min-height:40px;border-radius:6px;}
.cm-submenu-toggle svg{width:12px;height:12px;transition:transform .15s;}.cm-submenu-toggle[aria-expanded="true"] svg{transform:rotate(180deg);}
.cm-submenu{list-style:none;position:absolute;top:100%;left:-20px;min-width:285px;margin:0;padding:12px 20px 16px;background:#fffdf8;border:1px solid #dfe6dc;border-radius:4px 4px 18px 4px;box-shadow:0 12px 24px #294c5b12;}
.cm-submenu li{margin:0;padding:0;}.cm-site-header .cm-submenu a{font-size:13px;line-height:1.5;padding:11px 0;}
.cm-header-contact{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:44px;padding:12px 19px;border:1.5px solid #f89141;border-radius:30px;color:#203f4d;background:#f89141;text-decoration:none;font:800 12px/1.4 Nunito,Arial,sans-serif;white-space:nowrap;}
.cm-header-contact svg{width:18px;height:18px;flex:none;}
.cm-header-contact:hover{background:#ffa35b;border-color:#ffa35b;}.cm-header-contact[aria-current="page"]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:5px;}
.cm-menu-toggle{display:none;align-items:center;gap:9px;min-height:44px;padding:10px 12px;background:transparent;border:1px solid #bdcbbb;border-radius:8px;font:800 14px Nunito,Arial,sans-serif;color:#316573;}
.cm-menu-toggle svg{width:21px;height:21px;}.cm-site-header [hidden]{display:none!important;}
.cm-mobile-nav{display:none;}
.cm-site-footer{background:#f8faf3;color:#385567;padding:48px 0 24px;margin:0;border-top:1px solid #e4e7db;font:15px/1.7 Nunito,Arial,sans-serif;}
.cm-footer-wrap{max-width:1216px;margin:auto;padding:0 40px;}
.cm-footer-grid{display:grid;grid-template-columns:1.45fr .7fr 1.25fr .9fr;gap:38px;}
.cm-footer-brand>a{display:inline-block;margin-bottom:21px;}.cm-footer-brand img{width:264px;max-width:100%;height:auto;}
.cm-footer-brand address{font-style:normal;font-size:13px;line-height:1.75;}.cm-footer-brand address p{margin:0 0 10px;}.cm-footer-brand address a{color:#316573;text-decoration:none;}.cm-footer-brand address a:hover{text-decoration:underline;}
.cm-footer-contact-line{display:flex;align-items:flex-start;gap:12px;}.cm-footer-contact-line>.icon{width:18px;height:18px;flex:none;color:#5d9d85;margin-top:3px;}
.cm-footer-nav-group{display:flex;flex-direction:column;align-items:flex-start;gap:11px;}
.cm-footer-nav-group h3{font:700 22px/1.3 Kalam,cursive;color:#316573;margin:4px 0 12px;}
.cm-site-footer .cm-footer-nav-group a{font-size:13px;font-weight:700;line-height:1.55;text-decoration:none;color:#385567;display:inline-block;}
.cm-site-footer .cm-footer-nav-group a:hover,.cm-site-footer .cm-footer-nav-group a[aria-current="page"]{text-decoration:underline;text-decoration-color:#f89141;text-decoration-thickness:3px;text-underline-offset:5px;}
.cm-footer-bottom{margin-top:32px;padding-top:20px;border-top:1px solid #e0e5d7;display:flex;justify-content:space-between;gap:20px;font-size:11px;color:#6d8179;}
.cm-site-header a:focus-visible,.cm-site-header button:focus-visible,.cm-site-footer a:focus-visible{outline:2px solid #316573;outline-offset:5px;}
/* Un bleu suffisamment profond sur les CTA orange. */
body .button:not(.secondary){color:#203f4d;}
@media(max-width:1200px){.cm-header-inner{gap:15px;padding-left:30px;padding-right:30px;}.cm-brand{flex-basis:245px;}.cm-brand img{width:245px;}.cm-nav-list{gap:12px;}.cm-header-contact{font-size:12px;padding:11px 14px;}}
@media(max-width:1100px){
 .cm-header-inner{min-height:94px;padding:0 30px;gap:15px;}.cm-brand{flex-basis:275px;}.cm-brand img{width:275px;}.cm-nav{display:none;}.cm-header-contact{display:none;}.cm-menu-toggle{display:inline-flex;}
 .cm-mobile-nav:not([hidden]){display:block;border-top:1px solid #e4e8dc;padding:15px 28px 22px;background:#fffdf8;}
 .cm-mobile-nav ul{list-style:none;padding:0;margin:0;}.cm-mobile-nav li{padding:0;margin:0;}
 .cm-mobile-nav a{display:inline-block;color:#316573;font:800 15px/1.6 Nunito,Arial,sans-serif;text-decoration:none;padding:10px 0;}
 .cm-mobile-nav .cm-mobile-children{margin:0 0 8px 12px;border-left:2px solid #d8e3c2;padding-left:18px;}.cm-mobile-nav .cm-mobile-children a{font-size:14px;font-weight:700;}
 .cm-mobile-nav a[aria-current="page"],.cm-mobile-nav a.is-current-parent,.cm-mobile-nav a:hover{text-decoration:underline;text-decoration-color:#f89141;text-decoration-thickness:3px;text-underline-offset:5px;}
 .cm-footer-grid{grid-template-columns:1.1fr .8fr 1.3fr;gap:35px 28px;}.cm-footer-brand{grid-column:1/-1;display:grid;grid-template-columns:230px minmax(0,1fr);gap:32px;align-items:center;}.cm-footer-brand>a{margin:0;}.cm-footer-brand address{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 24px;}.cm-footer-brand address p{margin:0;}
}
@media(max-width:700px){
 .cm-header-inner{min-height:84px;padding:0 24px;gap:12px;}.cm-brand{flex-basis:auto;margin-right:auto;}.cm-brand img{width:244px;}.cm-header-contact{display:none;}.cm-menu-toggle{font-size:13px;padding:9px;gap:7px;}
 .cm-footer-wrap{padding:0 24px;}.cm-site-footer{padding-top:36px;}.cm-footer-grid{grid-template-columns:1fr 1.2fr;gap:32px 24px;}.cm-footer-brand{display:block;}.cm-footer-brand img{width:230px;}.cm-footer-brand address{display:block;margin-top:17px;}.cm-footer-brand address p{margin-bottom:8px;}.cm-footer-nav-group h3{font-size:21px;}.cm-footer-nav-group:last-child{grid-column:1/-1;}.cm-footer-bottom{flex-direction:column;gap:5px;margin-top:28px;}
}
@media(max-width:370px){.cm-header-inner{padding:0 20px;gap:10px;}.cm-brand img{width:214px;}.cm-menu-toggle{font-size:12px;}.cm-menu-toggle span{display:none;}.cm-footer-grid{grid-template-columns:1fr;}.cm-footer-nav-group:last-child{grid-column:auto;}}
@media(prefers-reduced-motion:reduce){.cm-submenu-toggle svg{transition:none;}}
@media print{.cm-site-header,.cm-site-footer{display:none;}}

