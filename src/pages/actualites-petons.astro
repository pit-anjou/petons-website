}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:white;padding:15px;z-index:20}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.tiny-star{font:34px/1 Georgia,serif;color:var(--orange);display:inline-block;transform:rotate(10deg);flex-shrink:0}.section-title{display:flex;align-items:center;gap:13px;margin-bottom:34px;min-width:0}.section-title>.icon{color:#6db35c;width:31px;height:31px}.section-title h2{position:relative;isolation:isolate;min-width:0;font-size:39px}.section-title h2:after{content:'';position:absolute;left:1px;bottom:1px;width:64%;height:5px;background:#f7bc78;border-radius:75% 25% 65% 45%;transform:rotate(-1.5deg);z-index:-1}.paper-band{background:var(--sand);position:relative;isolation:isolate}.paper-band:before,.paper-band:after{content:'';position:absolute;left:0;right:0;height:14px;background:inherit;z-index:-1;clip-path:polygon(0 60%,8% 25%,19% 52%,32% 14%,43% 51%,56% 20%,68% 65%,79% 30%,91% 60%,100% 30%,100% 100%,0 100%)}.paper-band:before{top:-13px}.paper-band:after{bottom:-13px;transform:rotate(180deg)}
