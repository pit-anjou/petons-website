<Footer /><FormSubmitScript /><script is:inline>(()=>{
 const dialogs=[...document.querySelectorAll('dialog')];let opener=null,previousOverflow='';
 document.querySelectorAll('[data-open]').forEach(button=>button.addEventListener('click',()=>{
  const dialog=document.getElementById(button.dataset.open);if(!dialog)return;
  opener=button;previousOverflow=document.body.style.overflow;dialog.showModal();document.body.style.overflow='hidden';dialog.scrollTop=0;
 }));
 dialogs.forEach(dialog=>{
  dialog.querySelector('[data-close]').addEventListener('click',()=>dialog.close());
  dialog.addEventListener('click',event=>{if(event.target===dialog){const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();}});
  dialog.addEventListener('close',()=>{document.body.style.overflow=previousOverflow;if(opener)opener.focus({preventScroll:true});});
 });
 const linkedArticle=document.getElementById(window.location.hash.slice(1));
 if(linkedArticle?.matches('.news-card')) linkedArticle.querySelector('[data-open]')?.click();
 const form=document.querySelector('#newsletter-form'),email=document.querySelector('#newsletter-email'),result=document.querySelector('#newsletter-result'),status=document.querySelector('#newsletter-status'),mailto=document.querySelector('#newsletter-mailto'),draft=document.querySelector('#newsletter-draft');let message='';
 form.addEventListener('submit',async event=>{
  event.preventDefault();if(!form.reportValidity())return;
  message=['Bonjour,','','Je souhaite recevoir La lettre des Petons à cette adresse : '+email.value.trim()+'.','','Merci et à bientôt.'].join('\n');
  const url='mailto:contact@lespetons.fr?subject='+encodeURIComponent('Demande d’abonnement — La lettre des Petons')+'&body='+encodeURIComponent(message);
  const envoye=await envoyerFormulaire(form,'lettre',{email:email.value.trim()});
  if(envoye){afficherEnvoiReussi(form,'Vérifiez votre boîte mail : un lien de confirmation vient de vous être envoyé.');return;}
  draft.value=message;mailto.href=url;result.hidden=false;status.textContent='L’envoi n’a pas abouti. Vous pouvez envoyer votre demande depuis votre messagerie, ou copier le message ci-dessous.';
 });
 email.addEventListener('input',()=>{result.hidden=true;});
 document.querySelector('#newsletter-copy').addEventListener('click',async()=>{
  try{await navigator.clipboard.writeText(message);status.textContent='Demande copiée. Collez-la dans un e-mail à contact@lespetons.fr.';}
  catch{result.querySelector('details').open=true;draft.focus();draft.select();status.textContent='La demande est sélectionnée : copiez-la puis collez-la dans votre messagerie.';}
 });
})();
