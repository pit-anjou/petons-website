.stage-dialog .stage-intro{padding-bottom:6px}
.stage-section-heading{display:flex;align-items:center;gap:10px}
.stage-section-heading>span{position:relative;isolation:isolate;padding-bottom:4px}
.stage-section-heading>span:after{content:"";position:absolute;left:0;bottom:2px;width:72%;height:4px;background:#f7bc78;border-radius:75% 25% 65% 45%;transform:rotate(-1.5deg);z-index:-1}
.stage-section-heading>.stage-section-icon{width:27px;height:27px;flex:none;color:#75a55d}
.stage-section-heading:after{content:"✧";font:25px/1 Georgia,serif;color:#f29548;margin-left:5px}
.stage-programme-art{width:100%;max-width:720px;margin:24px auto 8px}
.stage-programme-art img{display:block;width:100%;height:auto}
.stage-programme .stage-forces{gap:15px}
.stage-forces li{position:relative;padding:19px 22px 19px 67px;border:0;border-radius:5px 26px 5px 5px;background:#f0f5e7}
.stage-forces li:nth-child(2){background:#edf5f1}.stage-forces li:nth-child(3){background:#fff1df}
.stage-forces .stage-force-title{font:700 24px/1.3 Kalam,cursive;margin-bottom:8px}
.stage-force-icon{position:absolute;left:20px;top:21px;width:29px;height:29px;color:#7b9e5e}
.stage-forces li:nth-child(2) .stage-force-icon{color:#65998c}.stage-forces li:nth-child(3) .stage-force-icon{color:#ce965b}
.stage-step{display:grid;grid-template-columns:34px 1fr;gap:14px;padding:17px 0;border-bottom:1px solid #e1e7db}
.stage-step:last-child{border-bottom:0}
.stage-step>svg{width:30px;height:30px;margin-top:1px;color:#7fa288}
.stage-step h4{font:700 23px/1.35 Kalam,cursive;color:var(--heading);margin:0 0 7px}
.stage-step p{margin:0}
.stage-dialog .stage-finale{position:relative;padding:23px 25px;border:1px solid #ead8bb;border-radius:5px 30px 5px 5px;background:#fcf2e2}
.stage-finale h3{font-size:27px}
.stage-facilitator{padding:20px 21px 22px;background:#f5f5ed;border:1px solid #e3e6d8;border-radius:5px 29px 5px 5px}
.stage-facilitator:nth-child(2){background:#f0f6f2}
@media(max-width:600px){.stage-section-heading{gap:8px}.stage-section-heading:after{display:none}.stage-section-heading>.stage-section-icon{width:23px;height:23px}.stage-dialog .stage-intro>strong:first-child{font-size:17px}.stage-forces li{padding:17px 17px 17px 47px}.stage-force-icon{left:12px;top:19px;width:25px;height:25px}.stage-forces .stage-force-title{font-size:22px}.stage-step{grid-template-columns:25px 1fr;gap:11px}.stage-step>svg{width:25px;height:25px}.stage-step h4{font-size:22px}.stage-dialog .stage-finale{padding:19px}.stage-facilitator{padding:21px}.stage-dialog .stage-tags{padding-right:23px}}
</style>
<style is:inline>
/* Portes ouvertes : illustrations et photos originales, palette du site. */
.agenda-meta{min-height:150px}
