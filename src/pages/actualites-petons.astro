---
import Referencement from '../components/Referencement.astro';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteNavScript from '../components/SiteNavScript.astro';
import FormSubmitScript from '../components/FormSubmitScript.astro';
import { openHouse } from '../data/openHouse';
import StageCard from '../components/actualites/StageCard.astro';
import StageDialog from '../components/actualites/StageDialog.astro';
import ArticleCard from '../components/actualites/ArticleCard.astro';
import ArticleDialog from '../components/actualites/ArticleDialog.astro';
import RendezVousCard from '../components/actualites/RendezVousCard.astro';
import RendezVousDialog from '../components/actualites/RendezVousDialog.astro';
import { articlesAffiches, avecProgramme, rendezVousAffiches, stagesAffiches, verifierIdentifiants } from '../lib/actualites';
import { anneesStages } from '../lib/dates';
const openHouseEducators = [
  { name: 'Antoine', ages: '3–6 ans', image: 'assets/img/antoine-educateur-montessori-de.webp' },
  { name: 'Pauline', ages: '6–12 ans', image: 'assets/img/portrait-de-pauline.webp' },
];
const openHouseDateParts = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).formatToParts(new Date(openHouse.start));
const eventDatePart = (type: string) => openHouseDateParts.find(part => part.type === type)?.value;

// Contenus modifiables dans Page CMS : voir docs/page-cms.md.
const stages = avecProgramme(stagesAffiches(await getCollection('stages')), await getCollection('programmes'));
const rendezVous = rendezVousAffiches(await getCollection('rendezVous'));
const articles = articlesAffiches(await getCollection('articles'));

// Identifiants écrits en dur dans cette page, dans Header.astro (dont le bandeau OpenHouseAnnouncement.astro), Footer.astro et src/data/site.ts : une actualité ne doit pas porter le même nom de fichier.
const IDENTIFIANTS_PAGE = [
  'agenda', 'agenda-priority-design', 'agenda-title', 'cm-ambiences-menu', 'cm-mobile-menu', 'cm-school-menu', 'dialog-title', 'enrol-title', 'footer-support-title',
  'holiday-stages-design', 'inscriptions-ouvertes', 'journal', 'journal-title', 'letter-title', 'lettre', 'main',
  'newsletter-copy', 'newsletter-draft', 'newsletter-email', 'newsletter-form', 'newsletter-mailto', 'newsletter-piege', 'newsletter-result', 'newsletter-status',
  'oh-card-title', 'open-house-announcement', 'open-house-dialog', 'open-house-gallery-title', 'open-house-invitation',
  'page-title', 'portes-ouvertes', 'proposer-activite', 'soutenir-footer',
];
verifierIdentifiants([...stages, ...rendezVous, ...articles].map(({ id }) => id), IDENTIFIANTS_PAGE);
