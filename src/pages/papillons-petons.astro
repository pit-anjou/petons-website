---
import Referencement from '../components/Referencement.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SiteNavScript from '../components/SiteNavScript.astro';
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#fffdf8"><title>Les Papillons · Montessori 6–12 ans à Nantes | Les Petons dans l’Herbe</title><meta name="description" content="Découvrez les Papillons, notre ambiance Montessori 6–12 ans à Nantes : Pauline, les apprentissages, les sorties, la journée type et la préparation au collège."><style is:inline>@font-face {
  font-family: 'Nunito';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url(assets/fonts/nunito-400.woff2) format('woff2');
}
@font-face {
  font-family: 'Nunito';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url(assets/fonts/nunito-600.woff2) format('woff2');
}
@font-face {
  font-family: 'Nunito';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url(assets/fonts/nunito-700.woff2) format('woff2');
}
@font-face {
  font-family: 'Nunito';
  font-style: normal;
  font-weight: 800;
  font-display: swap;
  src: url(assets/fonts/nunito-800.woff2) format('woff2');
}
@font-face {
  font-family: 'Kalam';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url(assets/fonts/kalam-700.woff2) format('woff2');
}
:root{--ink:#3a5e71;--heading:#316573;--body:#385567;--aqua:#00b9c1;--mint:#01c493;--green:#81c94e;--lime:#cfdd51;--orange:#f89141;--paper:#fffdf8;--sand:#f7f1e6;--pale:#f0f5e8;--line:#dfe6dc;--title:Kalam,cursive}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;background:var(--paper);color:var(--body);font:16px/1.8 Nunito,Arial,sans-serif}h1,h2,h3{color:var(--heading);font-family:var(--title);font-weight:700;line-height:1.28;margin:0}h1{font-size:58px;letter-spacing:-1.2px}h2{font-size:39px;letter-spacing:-.6px}h3{font-size:27px}p{margin:0 0 20px}p:last-child{margin-bottom:0}a{color:var(--heading);text-underline-offset:5px}a:focus-visible,button:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--ink);outline-offset:5px}button{font:inherit;cursor:pointer}strong{font-weight:800}img{display:block;max-width:100%;height:auto}figure{margin:0}[hidden]{display:none!important}.wrap{width:min(1216px,100%);padding:0 40px;margin:auto}.section{padding-top:72px;padding-bottom:72px}.icon{width:26px;height:26px;flex-shrink:0}.eyebrow{display:block;text-transform:uppercase;font-size:10px;letter-spacing:1.5px;font-weight:800;line-height:1.7;margin-bottom:18px;color:var(--heading)}.painted{mix-blend-mode:multiply;object-fit:contain}.button{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:49px;padding:13px 24px;background:var(--orange);color:#294c5b;border:1.5px solid var(--orange);border-radius:30px;text-decoration:none;font-size:14px;line-height:1.4;font-weight:800}.button:hover{background:#ffa35b;border-color:#ffa35b}.button .icon{width:18px;height:18px}.button.secondary{background:transparent;border-color:#b2c4ba}.button.secondary:hover{background:#edf3e5}.text-link{display:inline-flex;gap:10px;align-items:center;font-size:14px;font-weight:800;text-decoration:none}.text-link:hover{text-decoration:underline}.text-link .icon{width:19px;height:19px;color:#b27b40}.actions{display:flex;gap:14px;align-items:center;flex-wrap:wrap}.soft-mark{background:linear-gradient(transparent 62%,#e3ecac 62%,#e3ecac 91%,transparent 91%);box-decoration-break:clone;-webkit-box-decoration-break:clone}.orange-mark{background:linear-gradient(transparent 64%,#f9d6ac 64%,#f9d6ac 93%,transparent 93%);box-decoration-break:clone;-webkit-box-decoration-break:clone}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;background:white;padding:15px;z-index:20}.tiny-star{font:34px/1 Georgia,serif;color:var(--orange);display:inline-block;transform:rotate(10deg);flex-shrink:0}.section-title{display:flex;align-items:center;gap:13px;margin-bottom:34px;min-width:0}.section-title>.icon{color:#6db35c;width:31px;height:31px}.section-title h2{position:relative;isolation:isolate;min-width:0;font-size:inherit;font-size:39px}.section-title h2:after{content:'';position:absolute;left:1px;bottom:1px;width:64%;height:5px;background:#f7bc78;border-radius:75% 25% 65% 45%;transform:rotate(-1.5deg);z-index:-1}.paper-band{background:var(--sand);position:relative;isolation:isolate}.paper-band:before,.paper-band:after{content:'';position:absolute;left:0;right:0;height:14px;background:inherit;z-index:-1;clip-path:polygon(0 60%,8% 25%,19% 52%,32% 14%,43% 51%,56% 20%,68% 65%,79% 30%,91% 60%,100% 30%,100% 100%,0 100%)}.paper-band:before{top:-13px}.paper-band:after{bottom:-13px;transform:rotate(180deg)}
header{background:#fcfcfa;border-bottom:1px solid #eee9df}.header-inner{height:114px;display:flex;justify-content:space-between;align-items:center;gap:24px}.brand{display:block;flex:none}.brand img{width:294px}.mainnav{display:flex;gap:21px;font-size:12px;font-weight:800;align-items:center}.mainnav a{white-space:nowrap;text-decoration:none}.mainnav a:hover{text-decoration:underline}.header-inner>.button{font-size:12px;min-height:44px;padding:12px 19px}.mobile-toggle{display:none}.mobile-nav{padding:8px 26px 25px;border-top:1px solid var(--line)}.mobile-nav a{display:block;padding:9px 0;font-weight:800;text-decoration:none}
footer{border-top:1px solid #e4e7db;background:#f8faf3;padding:48px 0 24px}.footer-grid{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr;gap:44px}.footer-brand img{width:264px;margin-bottom:21px}.contact-line{display:flex;align-items:center;gap:10px;margin:7px 0;font-size:12px;line-height:1.7}.contact-line>.icon{width:16px;height:16px;color:#6f8c77}.contact-line a{text-decoration:none}.footer-links h3{font-size:23px;margin:3px 0 17px}.footer-links a{display:block;font-size:12px;text-decoration:none;margin:7px 0;line-height:1.6}.footer-links a:hover{text-decoration:underline}.footer-bottom{border-top:1px solid #e0e5d7;margin-top:32px;padding-top:20px;font-size:10px;display:flex;justify-content:space-between;gap:20px;color:#6d8179}

/* Page Les Papillons — shared.css retains the exact site palette and embedded fonts. */
.mainnav{gap:23px}.nav-dropdown{position:relative}.nav-dropdown summary{cursor:pointer;display:flex;align-items:center;gap:7px;list-style:none;color:var(--heading);padding:12px 0;text-decoration:underline;text-decoration-color:#edb879;text-decoration-thickness:2px;text-underline-offset:7px}.nav-dropdown summary::-webkit-details-marker{display:none}.nav-dropdown summary:after{content:'';width:6px;height:6px;border-right:1.5px solid;border-bottom:1.5px solid;transform:rotate(45deg);margin-top:-3px}.nav-dropdown[open] summary:after{transform:rotate(225deg);margin-top:3px}.nav-submenu{position:absolute;top:100%;left:-22px;min-width:259px;padding:13px 21px;background:var(--paper);border:1px solid var(--line);border-radius:4px;box-shadow:0 12px 25px #38556712;z-index:10}.nav-submenu a{display:block;padding:11px 0;font-size:13px;line-height:1.45}.nav-submenu a[aria-current]{color:#42633b}.nav-submenu a[aria-current]:before{content:'•';margin-right:8px;color:#83b85b}.mobile-nav details{margin:0}.mobile-nav summary{font-weight:800;cursor:pointer;padding:9px 0;color:var(--heading)}.mobile-subnav{padding-left:17px;border-left:2px solid #d5e3b2;margin:2px 0 10px}.mobile-subnav a{font-size:14px}.mobile-subnav a[aria-current]{text-decoration:underline;text-decoration-color:var(--orange)}summary:focus-visible{outline:3px solid var(--ink);outline-offset:5px}
.breadcrumb{display:flex;gap:12px;align-items:center;padding-top:24px;color:#5b7376;font-size:11px}.breadcrumb a{text-decoration:none}.breadcrumb a:hover{text-decoration:underline}.breadcrumb>span[aria-hidden]{color:#a8b7a7}.butterflies-hero{display:grid;grid-template-columns:1fr 1.12fr;gap:32px;align-items:center;padding-top:33px;padding-bottom:43px}.hero-copy .eyebrow{margin-bottom:20px;font-size:10px}.hero-copy h1{font-size:62px;line-height:1.18}.hero-age{display:block;font-size:36px;letter-spacing:0;color:#75995c;margin-top:9px}.hero-underline{position:relative;display:inline-block;isolation:isolate;white-space:nowrap}.hero-underline:after{content:'';position:absolute;left:-2px;right:0;bottom:9px;height:16px;background:#e6edb4;z-index:-1;border-radius:60% 30% 50% 30%;transform:rotate(-1deg)}.hero-lead{font-family:var(--title);font-size:25px;line-height:1.5;color:var(--heading);margin:23px 0 16px}.hero-copy>p:not(.hero-lead){font-size:15.5px;line-height:1.85;max-width:465px;margin-bottom:14px}.hero-copy>.button{margin-top:13px}.hero-art{padding-top:13px;position:relative}.hero-art>:is(img,svg){width:100%;height:auto}.hero-art figcaption{text-align:center;font:700 25px/1.5 var(--title);margin-top:19px;color:#537a66}.page-index{position:relative;display:flex;align-items:center;gap:33px;font-size:12px;font-weight:800;padding-top:21px;padding-bottom:24px;margin-bottom:46px;flex-wrap:wrap}.page-index:before{content:'';position:absolute;left:40px;right:40px;top:0;height:1px;background:#e5e7dc}.page-index>span{font-size:9px;text-transform:uppercase;letter-spacing:1.4px;color:#738575;margin-right:8px}.page-index a{text-decoration:none;min-height:32px;display:flex;align-items:center}.page-index a:hover{text-decoration:underline}.section>.eyebrow{margin-bottom:13px}.large-copy{font:700 28px/1.55 var(--title);color:var(--heading)}
.daily-band .section{padding-top:46px;padding-bottom:39px}.daily-band .section-title{margin-bottom:25px}.daily-grid{display:grid;grid-template-columns:1.8fr 1fr;gap:85px;align-items:center}.daily-copy .large-copy{margin-bottom:21px}.daily-copy>p:not(.large-copy){font-size:15.5px;line-height:1.85}.daily-copy .text-link{margin-top:3px}.pauline-portrait{position:relative;max-width:276px;justify-self:center;width:100%;margin-top:-1px}.pauline-portrait img{width:100%;height:295px;object-fit:cover;object-position:50% 37%;border-radius:43% 43% 3px 3px;box-shadow:9px 9px 0 #e8e8cf}.pauline-portrait figcaption{text-align:center;margin-top:18px}.pauline-portrait figcaption strong{font:700 29px/1.2 var(--title);display:block;color:var(--heading)}.pauline-portrait figcaption span{font-size:11px;font-weight:700}.portrait-spark{position:absolute;right:-30px;top:19px;font:50px/1 Georgia;color:#e8b566;transform:rotate(10deg)}.daily-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px;border-top:1px solid #e2ddcf;margin-top:31px;padding-top:27px}.daily-notes>div{display:flex;gap:15px;align-items:flex-start}.daily-notes .icon{color:#749271;margin-top:7px;width:27px;height:27px}.daily-notes>div:nth-child(2) .icon{color:#b8834e}.daily-notes>div:nth-child(3) .icon{color:#529993}.daily-notes p{font-size:13px;line-height:1.8}.daily-notes strong{display:block;font:700 24px/1.5 var(--title);color:var(--heading);margin-bottom:5px}
.learning-intro{display:grid;grid-template-columns:1fr 1fr;gap:54px;margin-bottom:30px}.learning-intro p{font-size:15.5px;margin:0}.learning-grid{display:grid;grid-template-columns:.8fr 1.4fr;gap:49px;align-items:stretch}.material-photo{position:relative;margin:7px 5px 11px 0;max-height:494px}.material-photo img{height:100%;width:100%;object-fit:cover;object-position:52% 52%;clip-path:polygon(3% 0,100% 2%,98% 100%,0 98%)}.material-photo figcaption{position:absolute;bottom:20px;left:-8px;right:15px;padding:17px 21px 15px;background:var(--paper);border-left:3px solid #d5dfab;transform:rotate(-2deg);box-shadow:0 3px 15px #284d5110}.material-photo figcaption span{font-size:12px;display:block}.material-photo figcaption strong{font:700 23px/1.5 var(--title);color:var(--heading);display:block}.subjects{display:grid;grid-template-columns:1fr 1fr;gap:28px 32px}.subjects article{position:relative;padding-top:3px}.subjects .icon{color:#8b9f66;width:24px;height:24px;margin-bottom:9px}.subjects article:nth-child(3n+2) .icon{color:#b38350}.subjects article:nth-child(3n+3) .icon{color:#589497}.subjects h3{font-size:24px;margin-bottom:8px}.subjects p{font-size:14px;line-height:1.8}
.cosmic-band{background:#f0f5e8}.cosmic-band .section{padding-top:45px;padding-bottom:38px}.cosmic-intro{display:grid;grid-template-columns:.92fr 1.35fr;gap:75px;align-items:center}.cosmic-intro p{margin:0}.cosmic-intro>p:not(.large-copy){font-size:15px}.great-stories{list-style:none;padding:0;margin:30px 0 27px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:22px;position:relative}.great-stories li{position:relative;text-align:center;padding-top:9px}.story-art{display:flex;margin:0 auto 14px;width:64px;height:63px;align-items:center;justify-content:center;background:#e3ead2;border-radius:49% 46% 51% 43%;transform:rotate(-7deg)}.story-art .icon{width:33px;height:33px;color:#729259;transform:rotate(7deg)}.great-stories li:nth-child(2n) .story-art{background:#eee5cd;transform:rotate(9deg)}.great-stories li:nth-child(2n) .icon{color:#b58d51;transform:rotate(-9deg)}.great-stories li:nth-child(3) .story-art{background:#dfebe1}.great-stories li:nth-child(3) .icon{color:#61938b}.story-number{font:700 13px Nunito,sans-serif;display:block;color:#78905f;margin-bottom:4px}.great-stories h3{font-size:23px;line-height:1.4}.cosmic-ending{border-top:1px solid #d5dfc9;padding-top:22px;font-size:14px;text-align:center;margin-bottom:17px}.cosmic-band .text-link{display:flex;width:fit-content;margin:0 auto;font-size:13px}
.projects-section{padding-bottom:33px}.projects-grid{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:53px}.projects-art img{width:100%}.projects-art figcaption{text-align:center;font:700 24px/1.5 var(--title);color:#5b806b;margin-top:14px}.projects-copy>p{font-size:15.5px}.project-steps{display:flex;flex-direction:column;gap:19px}.project-steps>div{display:flex;gap:16px}.project-steps>div>span{font:700 32px/1 var(--title);color:#91a56b;min-width:20px;margin-top:6px}.project-steps p{font-size:14px;line-height:1.8}.project-steps strong{display:block;font-size:15px;margin-bottom:3px}.community-note{display:flex;align-items:flex-start;gap:20px;border-left:3px solid #d5e0b2;padding:9px 23px 9px 25px;margin-top:39px}.community-note>.icon{width:28px;height:28px;color:#9ca66c;margin-top:5px}.community-note h3{font-size:25px;margin-bottom:9px}.community-note p{font-size:14.5px;line-height:1.85;max-width:970px}
.outings-section{padding-top:35px}.outings-section:before{content:'';display:block;width:100%;height:1px;background:#e1e6db;margin-bottom:36px}.outings-grid{display:grid;grid-template-columns:1.13fr 1fr;gap:76px;align-items:start}.outings-copy>p{font-size:15.5px}.outing-places{display:flex;flex-direction:column;gap:18px;margin-top:26px}.outing-places>div{display:flex;align-items:center;gap:17px}.outing-places .icon{width:26px;height:26px;color:#81966b}.outing-places>div:nth-child(2) .icon{color:#c08d4f}.outing-places p{font-size:13px;line-height:1.8}.outing-places strong{font-size:15px;display:block}.music-outing{position:relative;padding:30px 31px 31px;margin-top:5px;isolation:isolate}.music-outing:before{content:'';position:absolute;inset:0;background:#f4f5e9;clip-path:polygon(0 2%,100% 0,98% 100%,1% 99%);z-index:-1}.music-motif{position:absolute;right:24px;top:29px;color:#a7b075;display:flex;gap:5px;align-items:center}.music-motif .icon{width:39px;height:39px}.music-motif span{color:#e6ba70;font:23px Georgia}.music-outing .eyebrow{font-size:8px;letter-spacing:1.3px;max-width:245px;margin-bottom:21px}.music-outing h3{font-size:35px;line-height:1.3;margin-bottom:17px}.music-lead{font:700 23px/1.5 var(--title);color:#53776b;margin-bottom:17px}.music-outing>p:not(.music-lead){font-size:14px;line-height:1.85}.music-outing .text-link{font-size:12px;line-height:1.6}.outings-bottom{display:flex;align-items:center;justify-content:space-between;gap:22px;margin-top:34px;border-top:1px solid #e3e7dc;padding-top:20px}.outings-bottom p{font:700 22px/1.5 var(--title);color:#6d8a6d;margin:0}.outings-bottom .text-link{font-size:13px}
.day-band .section{padding-top:43px;padding-bottom:29px}.day-heading{display:flex;justify-content:space-between;align-items:center;gap:30px}.day-heading .eyebrow{margin-bottom:13px}.day-heading .section-title{margin-bottom:18px}.day-heading h2{font-size:36px}.school-days{font:700 20px/1.5 var(--title);text-align:right;color:#648365;flex:none;margin-bottom:0}.day-intro{font-size:15px;margin-bottom:31px;max-width:730px}.day-columns{display:grid;grid-template-columns:1fr 1fr;gap:65px}.day-half h3{display:flex;align-items:center;gap:13px;font-size:27px;margin:0 0 21px}.day-half h3 .icon{color:#c3a15f;width:25px;height:25px}.day-half.afternoon h3 .icon{color:#7e9964}.timeline{list-style:none;margin:0;padding:0}.timeline li{display:grid;grid-template-columns:66px 1fr;gap:21px;position:relative;padding-bottom:21px}.timeline li:last-child{padding-bottom:0}.timeline li:before{content:'';position:absolute;left:66px;top:11px;bottom:-11px;border-left:1px solid #d4d9c9}.timeline li:last-child:before{display:none}.timeline li:after{content:'';position:absolute;left:63px;top:9px;border-radius:50%;width:7px;height:7px;background:#b4bd91}.timeline time{font-size:15px;font-weight:800;line-height:1.7;color:#72885d}.timeline h4{font-size:15px;line-height:1.7;margin:0 0 2px;color:var(--heading)}.timeline p{font-size:13px;line-height:1.7;max-width:360px}.midday-strip{margin-top:28px;padding:20px 0 15px;border-top:1px solid #dedecd;display:flex;align-items:center;gap:18px;flex-wrap:wrap}.midday-strip>.icon{color:#b2955b;width:26px;height:26px}.midday-strip>strong{font:700 24px var(--title);color:var(--heading);margin-right:3px}.midday-strip p{display:flex;gap:20px;margin:0;font-size:13px}.midday-strip .text-link{margin-left:auto;font-size:12px}.midday-strip .text-link .icon{width:16px;height:16px}.schedule-note{font-size:12px;font-style:italic;color:#6e7b70;margin:3px 0 0}
.future-section{padding-bottom:43px}.future-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:80px}.future-grid .large-copy{font-size:30px;margin-bottom:21px}.future-grid>div>p:not(.large-copy){font-size:15.5px}.future-skills{display:flex;flex-direction:column;gap:24px;padding-top:10px}.future-skills>div{display:flex;gap:20px}.future-skills .icon{width:26px;height:26px;color:#869e67;margin-top:5px}.future-skills>div:nth-child(2n) .icon{color:#be9866}.future-skills p{font-size:14px;line-height:1.8}.future-skills strong{display:block;font-size:15px;color:var(--heading);margin-bottom:5px}.transition-note{display:flex;align-items:center;gap:21px;margin-top:28px;padding-top:24px;border-top:1px solid #e0e5d8}.transition-note .tiny-star{font-size:34px}.transition-note p{font-size:13px;max-width:710px;margin:0}.transition-note .text-link{font-size:12px;margin-left:auto;flex:none}
