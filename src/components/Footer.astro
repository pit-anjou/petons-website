---
import { brand, contact, currentFile, footerNav, support } from '../data/site';

interface Props {
  /** Remplace le lien « mailto: » de l'adresse email (ex. vers le formulaire de contact). */
  emailHref?: string;
}

const { emailHref = `mailto:${contact.email}` } = Astro.props;
const current = currentFile(Astro.url.pathname);
const supportHref = current === support.href ? support.anchor : support.href;
const ariaCurrent = (href: string) => (href === current ? 'page' : undefined);
const icon = {
  class: 'icon',
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.6',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
};
---
<footer class="cm-site-footer">
  <div class="cm-footer-wrap">
    <div class="cm-footer-grid">
      <div class="cm-footer-brand">
        <a href={brand.href} aria-label={brand.label} aria-current={ariaCurrent(brand.href)}>
          <img src={brand.logo.src} class="" alt={brand.logo.alt} width={brand.logo.width} height={brand.logo.height} decoding="async">
        </a>
        <address>
          <p class="cm-footer-contact-line">
            <svg {...icon}><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>{contact.address[0]}<br>{contact.address[1]}</span>
          </p>
          <p class="cm-footer-contact-line">
            <svg {...icon}><path d="M22 17v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-1 1.7l-1.2.7a14 14 0 0 0 7.8 7.8l.7-1.2A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2Z"></path></svg>
            <a href={contact.phone.href}>{contact.phone.label}</a>
          </p>
          <p class="cm-footer-contact-line">
            <svg {...icon}><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m2 7 9 6a2 2 0 0 0 2 0l9-6"></path></svg>
            <a href={emailHref}>{contact.email}</a>
          </p>
          <p class="cm-footer-contact-line">
            <svg {...icon}><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"></circle></svg>
            <a href={contact.instagram.href} target="_blank" rel="noopener noreferrer" aria-label="Les Petons dans l’Herbe sur Instagram, nouvel onglet">{contact.instagram.handle}</a>
          </p>
        </address>
      </div>
      {footerNav.map((group) => (
        <nav class="cm-footer-nav-group" aria-label={group.title}>
          <h3>{group.title}</h3>
          {group.links.map((link) => (
            <a href={link.href} aria-current={ariaCurrent(link.href)}>{link.label}</a>
          ))}
        </nav>
      ))}
    </div>
    <aside class="cm-footer-support" id="soutenir-footer" aria-labelledby="footer-support-title">
      <div class="cm-footer-support-art" aria-hidden="true">
        <img src={support.image.src} alt="" width={support.image.width} height={support.image.height} loading="lazy" decoding="async">
      </div>
      <div class="cm-footer-support-copy">
        <span class="eyebrow">{support.eyebrow}</span>
        <h2 id="footer-support-title">{support.title}</h2>
        <p>{support.text}</p>
      </div>
      <a class="button" href={supportHref}>{support.cta}<svg {...icon}><path d="M5 12h14m-7-7 7 7-7 7"></path></svg></a>
    </aside>
    <div class="cm-footer-bottom">
      <span>Les Petons dans l’Herbe · École Montessori éco-citoyenne</span>
      <span>Nantes Nord · 3–12 ans</span>
    </div>
  </div>
</footer>
