---
// Illustration animée du carnaval. Les animations sont dans public/assets/css/enfants-animes.css.
interface Props {
  label: string;
  class?: string;
}

const { label, class: classe } = Astro.props;
---
<svg class:list={[classe, "painted puppet puppet--carnaval"]} viewBox="0 0 1536 1024" role="img" aria-label={label}><svg width="1536" height="1024" viewBox="0 0 1536 1024"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg><g class="pz pz-star-a" style="transform-origin:428px 140px"><svg x="388" y="100" width="76" height="82" viewBox="0 1028 76 82"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g><g class="pz pz-star-b" style="transform-origin:1190px 172px"><svg x="1153" y="135" width="77" height="76" viewBox="80 1028 77 76"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g><g class="pz pz-antenna-a" style="transform-origin:705px 285px"><svg x="635" y="194" width="97" height="104" viewBox="161 1028 97 104"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g><g class="pz pz-antenna-b" style="transform-origin:800px 258px"><svg x="779" y="156" width="86" height="112" viewBox="262 1028 86 112"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g><g class="pz pz-clown-hand" style="transform-origin:150px 380px"><svg x="83" y="306" width="90" height="88" viewBox="352 1028 90 88"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g><g class="pz pz-ballerina-arm" style="transform-origin:1152px 355px"><svg x="1142" y="239" width="75" height="130" viewBox="446 1028 75 130"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g><g class="pz pz-pyjama-head" style="transform-origin:1288px 470px"><svg x="1184" y="255" width="238" height="224" viewBox="525 1028 238 224"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g><g class="pz pz-teddy-head" style="transform-origin:1345px 564px"><svg x="1298" y="457" width="98" height="114" viewBox="767 1028 98 114"><image href="assets/img/anim/carnaval.webp" width="1536" height="1252"/></svg></g></svg>
