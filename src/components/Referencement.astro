---
// Titre, description, canonical, aperçu de partage (Open Graph, X/Twitter) et JSON-LD de la page
// (l’école, le site, la page : src/data/donneesStructurees.ts).
// Les adresses absolues viennent toutes de `site` dans astro.config.mjs.
import { currentPage } from '../data/site';
import { donneesStructurees } from '../data/donneesStructurees';

interface Props {
  /** Titre de l’onglet, repris par les aperçus de partage. */
  readonly title: string;
  /** Description pour les moteurs de recherche, reprise par les aperçus de partage. */
  readonly description: string;
  /** Image d’aperçu (1200 × 630, JPEG ou PNG) ; par défaut, l’image commune du site. */
  readonly image?: { readonly src: string; readonly alt: string };
  /** Nom et description schema.org « WebPage » de la page ; par défaut, le titre et la description. */
  readonly page?: { readonly name: string; readonly description: string };
  /** Ajoute aux données structurées l’événement des portes ouvertes (src/data/openHouse.ts). */
  readonly portesOuvertes?: boolean;
}

const nomDuSite = 'Les Petons dans l’Herbe';
const imageParDefaut = {
  src: 'assets/img/partage/les-petons-dans-lherbe.jpg',
  alt: 'Une enfant aux cheveux bouclés pose le plus petit cube de la tour rose Montessori, dans une classe lumineuse.',
};

const { title, description, image = imageParDefaut, page, portesOuvertes } = Astro.props;
const site = Astro.site;
if (!site) throw new Error('Déclarer `site` dans astro.config.mjs.');

const canonical = new URL(currentPage(Astro.url.pathname), site).href;
const imageAbsolue = new URL(image.src, site).href;
const jsonLd = donneesStructurees({
  site,
  page: { url: canonical, name: page?.name ?? title, description: page?.description ?? description },
  image: imageParDefaut.src,
  portesOuvertes,
});
---
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:locale" content="fr_FR">
<meta property="og:site_name" content={nomDuSite}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={imageAbsolue}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={image.alt}>
<meta name="twitter:card" content="summary_large_image">
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
