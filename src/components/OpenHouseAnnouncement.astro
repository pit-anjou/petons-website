---
import { openHouse } from '../data/openHouse';
const parts = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }).formatToParts(new Date(openHouse.start));
const datePart = (type: string) => parts.find(part => part.type === type)?.value;
---
<link rel="stylesheet" href="assets/css/open-house-announcement.css">
<div id="open-house-announcement" data-campaign={openHouse.id} data-end={openHouse.end}>
  <aside class="oh-banner" aria-label="Prochaines portes ouvertes" hidden>
    <div class="oh-banner-inner">
      <a class="oh-banner-link" href={openHouse.href} data-oh-action>
        <span class="oh-banner-heading"><strong>{openHouse.title}</strong><span>Venez découvrir l’école en famille</span></span>
        <span class="oh-banner-date"><time datetime={openHouse.start}>{openHouse.date}</time><span><b>{openHouse.hours}</b> · Entrée libre</span></span>
      </a>
      <button class="oh-banner-cta" type="button" data-oh-reopen aria-controls="open-house-invitation" aria-expanded="false">Voir l’invitation <span aria-hidden="true">↗</span></button>
      <button type="button" class="oh-close" data-oh-close-banner aria-label="Masquer le bandeau des portes ouvertes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg></button>
    </div>
  </aside>
  <aside id="open-house-invitation" class="oh-card" aria-labelledby="oh-card-title" hidden>
    <button type="button" class="oh-close" data-oh-close-card aria-label="Fermer l’annonce des portes ouvertes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg></button>
    <div class="oh-card-heading">
      <time class="oh-card-calendar" datetime={openHouse.start} aria-label={openHouse.date}>
        <span class="oh-calendar-weekday">{datePart('weekday')}</span>
        <strong>{datePart('day')}</strong>
        <span class="oh-calendar-month">{datePart('month')}</span>
        <span class="oh-calendar-year">{datePart('year')}</span>
      </time>
      <div class="oh-card-title-group">
        <h2 id="oh-card-title">Portes<br>ouvertes</h2>
        <p class="oh-card-welcome">Venez en famille</p>
        <p class="oh-card-hours">{openHouse.hours}<span>Entrée libre</span></p>
      </div>
    </div>
    <div class="oh-card-art"><img data-src={openHouse.illustration} alt="" width="1200" height="800" decoding="async"></div>
    <div class="oh-card-copy">
      <div class="oh-card-programme">
        <div><h3>Explorez</h3><p>Les ambiances <strong>3–6 ans et 6–12 ans</strong> et le matériel Montessori.</p></div>
        <div><h3>Rencontrez</h3><p>Les éducateurs et échangez avec <strong>les parents.</strong></p></div>
      </div>
      <a class="oh-card-button" href={openHouse.href} data-oh-action>Je prépare ma visite <span aria-hidden="true">→</span></a>
    </div>
  </aside>
</div>
<script is:inline src="assets/js/open-house-announcement.js"></script>
